<Window x:Class="Tandem.App.Views.CopySetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Tandem.App.Controls"
        Style="{StaticResource Window.Dialog}"
        Width="520" SizeToContent="Height" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Copy app setup" Icon="pack://application:,,,/Tandem;component/Assets/Tandem.ico">
  <Grid>
    <StackPanel Margin="32,28,32,28">
      <Border Width="42" Height="42" CornerRadius="21" HorizontalAlignment="Left" Margin="0,0,0,16" Background="{DynamicResource Brush.AccentSoft}">
        <TextBlock Text="&#xE8C8;" Style="{StaticResource Text.Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.AccentText}" />
      </Border>
      <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" />
      <TextBlock Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,6,0,20"
                 Text="Copies the Claude app's local setup into this account. Chats and projects stay with each account; sign-in, history and device identity are never copied." />

      <TextBlock Text="Copy from" Style="{StaticResource Text.Section}" FontSize="13" Margin="0,0,0,7" />
      <ComboBox x:Name="Source" DisplayMemberPath="DisplayName" SelectionChanged="OnSourceChanged" />

      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12" Background="{DynamicResource Brush.Sidebar}">
        <ItemsControl x:Name="ItemsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,3,0,0"
                           Foreground="{DynamicResource Brush.Success}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="{Binding RelativePath}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <TextBlock x:Name="EmptyText" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" Visibility="Collapsed"
                 Text="That account has no app setup to copy yet." />
      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0" LineHeight="17"
                 Text="Files this account already has go to the Recycle Bin first. Some MCP servers keep API keys in their settings; they are copied too, on this computer only." />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="CopyButton" Content="Copy setup" Style="{StaticResource Button.Primary}" IsDefault="True" Click="OnCopy" MinWidth="110" />
      </StackPanel>
    </StackPanel>
    <c:TitleBar ShowMinimize="False" ShowMaximize="False" />
  </Grid>
</Window>
