<Window x:Class="Tandem.App.Views.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Tandem.App.Controls"
        Style="{StaticResource Window.Chrome}"
        Title="Tandem" Width="1000" Height="720" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Tandem;component/Assets/Tandem.ico">
  <Window.Resources>
    <!-- Dashed "add another account" tile. -->
    <Style x:Key="AddTile" TargetType="Button" BasedOn="{StaticResource Button.Base}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Rectangle x:Name="Dash" RadiusX="16" RadiusY="16" StrokeThickness="1.5" StrokeDashArray="4 3"
                         Stroke="{DynamicResource Brush.BorderStrong}" Fill="Transparent" />
              <ContentPresenter Margin="18,16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Dash" Property="Fill" Value="{DynamicResource Brush.AccentSoft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A numbered step (onboarding and "how it works"). -->
    <Style x:Key="StepCircle" TargetType="Border">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource Brush.Badge}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="TextElement.FontSize" Value="13" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <!-- A usage meter colored by how full the limit is (DataContext: LimitView). -->
    <Style x:Key="LevelBar" TargetType="c:UsageBar">
      <Setter Property="Track" Value="{DynamicResource Brush.Badge}" />
      <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="Medium">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="High">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="Full">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One limit on the Usage page: name, percentage, meter, reset line. -->
    <DataTemplate x:Key="LimitMeter">
      <StackPanel>
        <Grid>
          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock x:Name="Percent" Text="{Binding PercentText}" FontFamily="{StaticResource Font.Display}" FontSize="26" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="used" FontSize="12" Margin="5,0,0,4" VerticalAlignment="Bottom" Foreground="{DynamicResource Brush.TextMuted}" />
          </StackPanel>
        </Grid>
        <c:UsageBar Value="{Binding Value}" Height="8" Margin="0,8,0,9" Style="{StaticResource LevelBar}" />
        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="Full">
          <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One limit on an account card: a small meter and "5-hour 45%". -->
    <DataTemplate x:Key="LimitCompact">
      <StackPanel Orientation="Horizontal" Margin="0,0,18,0" Background="Transparent" ToolTip="{Binding Detail}">
        <c:UsageBar Value="{Binding Value}" Width="54" Height="5" VerticalAlignment="Center" Style="{StaticResource LevelBar}" />
        <TextBlock Text="{Binding Compact}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ================= Sidebar ================= -->
    <Border Background="{DynamicResource Brush.Sidebar}">
      <DockPanel Margin="14,18,14,18">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,30">
          <Image Source="pack://application:,,,/Tandem;component/Assets/Tandem.ico" Width="30" Height="30"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Tandem" Style="{StaticResource Text.Heading}" FontSize="22" Margin="11,0,0,1" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,4,0">
          <Border Height="1" Margin="0,0,0,14" Background="{DynamicResource Brush.Border}" />
          <TextBlock Style="{StaticResource Text.Caption}" LineHeight="16"
                     Text="Unofficial. Not affiliated with or endorsed by Anthropic." />
          <TextBlock x:Name="SidebarVersion" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel>
          <RadioButton x:Name="NavAccounts" Style="{StaticResource NavItem}" Tag="&#xE716;" Content="Accounts" IsChecked="True" Checked="OnNav" />
          <RadioButton x:Name="NavUsage" Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="Usage" Checked="OnNav" />
          <RadioButton x:Name="NavSwitching" Style="{StaticResource NavItem}" Tag="&#xE8AB;" Content="Switching" Checked="OnNav" />
          <RadioButton x:Name="NavSignIn" Style="{StaticResource NavItem}" Tag="&#xE8D7;" Content="Sign-in" Checked="OnNav" />
          <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="General" Checked="OnNav" />
          <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" Checked="OnNav" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= Content ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <c:TitleBar ShowMinimize="True" ShowMaximize="True" />

      <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{StaticResource ScrollViewer.Modern}">
        <Grid x:Name="Pages" Margin="48,8,48,48" MaxWidth="860" HorizontalAlignment="Stretch">
          <Grid.RenderTransform>
            <TranslateTransform />
          </Grid.RenderTransform>

          <!-- ============ Accounts ============ -->
          <StackPanel x:Name="PageAccounts">
            <Grid Margin="0,0,0,26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Accounts" Style="{StaticResource Text.Display}" />
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,6,0,0"
                           Text="Each account has its own Claude window. Sign in once and it stays signed in." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenAllButton" Margin="0,0,8,0" Click="OnOpenAll" ToolTip="Start every account that is not open yet">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,9,0" />
                    <TextBlock Text="Open all" />
                  </StackPanel>
                </Button>
                <Button x:Name="ArrangeButton" Margin="0,0,8,0" Click="OnArrange" ToolTip="Put the open account windows side by side">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A9;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,9,0" />
                    <TextBlock Text="Arrange" />
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Text.Icon}" FontSize="9" Margin="8,1,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Primary}" Click="OnAddAccount">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,9,0" />
                    <TextBlock Text="Add account" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border x:Name="ClaudeMissingNotice" Style="{StaticResource Notice}" Margin="0,0,0,16" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,12,0" />
                <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                           Text="The Claude desktop app is not installed for this Windows user. Install it from claude.ai/download, then come back." />
              </StackPanel>
            </Border>

            <!-- Getting started -->
            <Border x:Name="Onboarding" Style="{StaticResource Card}" Margin="0,0,0,22" Padding="24,20,24,22">
              <Grid>
                <StackPanel>
                  <TextBlock Text="Set up your second account" Style="{StaticResource Text.Heading}" FontSize="20" />
                  <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,18" Text="Three steps, once. After that, switching is one click." />

                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Step1Circle" Style="{StaticResource StepCircle}">
                      <TextBlock x:Name="Step1Mark" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,4,12,0">
                      <TextBlock Text="Add an account" Style="{StaticResource Text.Section}" />
                      <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0" Text="Give it a name and a color. A new Claude window opens for it." />
                    </StackPanel>
                    <Button x:Name="Step1Button" Grid.Column="2" Content="Add account" VerticalAlignment="Center" Click="OnAddAccount" />
                  </Grid>

                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Step2Circle" Style="{StaticResource StepCircle}">
                      <TextBlock x:Name="Step2Mark" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,4,12,0">
                      <TextBlock Text="Turn on the sign-in helper" Style="{StaticResource Text.Section}" />
                      <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0" Text="So the sign-in from your browser reaches the new account, not your original one." />
                    </StackPanel>
                    <Button x:Name="Step2Button" Grid.Column="2" Content="Turn on" VerticalAlignment="Center" Click="OnHelperButton" />
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StepCircle}">
                      <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,4,12,0">
                      <TextBlock Text="Sign in once" Style="{StaticResource Text.Section}" />
                      <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                                 Text="Sign in inside the new window. From then on it stays signed in, just like your original Claude." />
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-6,-10,0" ToolTip="Hide" Click="OnDismissOnboarding" />
              </Grid>
            </Border>

            <ItemsControl x:Name="ProfileList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card.Interactive}" Margin="0,0,0,12" Padding="18,16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="46" Height="46">
                        <Border CornerRadius="23" Background="{Binding ColorBrush}">
                          <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Font.Display}" FontSize="20" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </Border>
                        <Ellipse x:Name="RunDot" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                                 Fill="{DynamicResource Brush.Success}" Stroke="{DynamicResource Brush.Surface}" StrokeThickness="2.5"
                                 Visibility="{Binding RunningVisibility}" />
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource Brush.Text}" />
                          <Border x:Name="PlanChip" Style="{StaticResource Chip}" Visibility="{Binding PlanVisibility}" ToolTip="Subscription (set by you)">
                            <TextBlock Text="{Binding PlanText}" FontWeight="SemiBold" />
                          </Border>
                          <Border Style="{StaticResource Chip.Accent}" Visibility="{Binding CurrentBadgeVisibility}">
                            <TextBlock Text="Current" />
                          </Border>
                          <Border Style="{StaticResource Chip}" Visibility="{Binding DefaultBadgeVisibility}">
                            <TextBlock Text="Original" />
                          </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                          <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" />
                          <TextBlock Text="  ·  " FontSize="12.5" Foreground="{DynamicResource Brush.TextSubtle}" />
                          <TextBlock Text="{Binding LastUsedText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" />
                        </StackPanel>
                        <WrapPanel Margin="0,7,0,1" Visibility="{Binding UsageVisibility}">
                          <ContentControl Content="{Binding UsageFiveHour}" ContentTemplate="{StaticResource LimitCompact}" Focusable="False" Margin="0,1" />
                          <ContentControl Content="{Binding UsageWeekly}" ContentTemplate="{StaticResource LimitCompact}" Focusable="False" Margin="0,1" />
                          <TextBlock Text="{Binding UsageLimitText}" Visibility="{Binding UsageLimitVisibility}" FontSize="12" FontWeight="SemiBold"
                                     Margin="0,1" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Danger}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding FolderText}" ToolTip="{Binding FolderText}" FontSize="11.5" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSubtle}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ActionButton" Content="{Binding ActionLabel}" Style="{StaticResource Button.Primary}"
                                MinWidth="92" Click="OnSwitch" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE712;" Margin="8,0,0,0" Click="OnMore" ToolTip="More" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter TargetName="ActionButton" Property="Style" Value="{StaticResource Button.Secondary}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="Open">
                      <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="Background">
                      <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                      <Setter TargetName="RunDot" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                      <Setter TargetName="Status" Property="ToolTip" Value="Its window is closed, but Claude keeps running in the tray." />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Profile.Plan}" Value="Max">
                      <Setter TargetName="PlanChip" Property="Style" Value="{StaticResource Chip.Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Profile.Plan}" Value="Team">
                      <Setter TargetName="PlanChip" Property="Style" Value="{StaticResource Chip.Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Profile.Plan}" Value="Enterprise">
                      <Setter TargetName="PlanChip" Property="Style" Value="{StaticResource Chip.Accent}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource AddTile}" Click="OnAddAccount" Margin="0,2,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,10,0" Foreground="{DynamicResource Brush.AccentText}" />
                <TextBlock Text="Add another account" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- ============ Usage ============ -->
          <StackPanel x:Name="PageUsage" Visibility="Collapsed">
            <Grid Margin="0,0,0,26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Usage" Style="{StaticResource Text.Display}" />
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,6,0,0"
                           Text="How much of each account's limits is used, so you can pick the one with the most room." />
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Center" Click="OnRefreshUsage" ToolTip="Read the latest numbers now">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,9,0" />
                  <TextBlock Text="Refresh" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- The account to use now. -->
            <Border x:Name="BestCard" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,20" Visibility="Collapsed"
                    Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.NoticeBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="BestAvatar" Width="52" Height="52" CornerRadius="26" VerticalAlignment="Center">
                  <TextBlock x:Name="BestInitial" FontFamily="{StaticResource Font.Display}" FontSize="23" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                  <TextBlock x:Name="BestCaption" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" />
                  <TextBlock x:Name="BestTitle" Style="{StaticResource Text.Heading}" FontSize="22" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <TextBlock x:Name="BestText" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="BestButton" Grid.Column="2" Style="{StaticResource Button.Primary}" MinWidth="100" VerticalAlignment="Center" Click="OnUseBest" />
                <Border x:Name="BestInUse" Grid.Column="2" Style="{StaticResource Chip.Success}" Padding="10,4,10,5" VerticalAlignment="Center" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,1,7,0" Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock Text="You're using it" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border x:Name="SameAccountNotice" Style="{StaticResource Notice}" Margin="0,0,0,16" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Warning}" Margin="0,1,12,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SameAccountText" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
              </Grid>
            </Border>

            <ItemsControl x:Name="UsageList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18,22,18">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{Binding ColorBrush}">
                          <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                            <Border x:Name="PlanChip" Style="{StaticResource Chip}" Visibility="{Binding PlanVisibility}" ToolTip="Subscription (set by you)">
                              <TextBlock Text="{Binding PlanText}" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Chip.Accent}" Visibility="{Binding CurrentBadgeVisibility}">
                              <TextBlock Text="Current" />
                            </Border>
                            <Border Style="{StaticResource Chip.Success}" Visibility="{Binding BestVisibility}" ToolTip="The most room left right now">
                              <TextBlock Text="Most room" FontWeight="SemiBold" />
                            </Border>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="State" Text="{Binding StateText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBlock Text="  ·  " FontSize="12.5" Foreground="{DynamicResource Brush.TextSubtle}" />
                            <TextBlock Text="{Binding UpdatedText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" />
                          </StackPanel>
                        </StackPanel>
                        <Button x:Name="UsageAction" Grid.Column="2" Content="{Binding ActionLabel}" Style="{StaticResource Button.Primary}"
                                MinWidth="92" VerticalAlignment="Center" Click="OnSwitch" />
                      </Grid>

                      <Border Visibility="{Binding LimitVisibility}" Margin="0,14,0,0" Padding="12,8" CornerRadius="10" Background="{DynamicResource Brush.DangerSurface}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,1,10,0" Foreground="{DynamicResource Brush.Danger}" />
                          <TextBlock Text="{Binding LimitText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" />
                        </StackPanel>
                      </Border>

                      <Grid Margin="0,18,0,0" Visibility="{Binding DataVisibility}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding FiveHour}" ContentTemplate="{StaticResource LimitMeter}" Focusable="False" />
                        <ContentControl Grid.Column="2" Content="{Binding Weekly}" ContentTemplate="{StaticResource LimitMeter}" Focusable="False" />
                      </Grid>

                      <StackPanel Margin="0,20,0,0" Visibility="{Binding DataVisibility}">
                        <Grid>
                          <TextBlock Text="Last 7 days" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" />
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Width="12" Height="3" CornerRadius="1.5" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="Weekly" FontSize="11.5" Margin="6,0,14,0" Foreground="{DynamicResource Brush.TextMuted}" />
                            <Border Width="12" Height="2" CornerRadius="1" Background="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Center" />
                            <TextBlock Text="5-hour" FontSize="11.5" Margin="6,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
                          </StackPanel>
                        </Grid>
                        <c:UsageChart Height="118" Margin="0,10,0,0" Samples="{Binding History}"
                                      WeeklyBrush="{DynamicResource Brush.Accent}" WeeklyFill="{DynamicResource Brush.AccentSoft}"
                                      FiveHourBrush="{DynamicResource Brush.TextSubtle}" GridBrush="{DynamicResource Brush.Border}"
                                      LabelBrush="{DynamicResource Brush.TextSubtle}" TipBackground="{DynamicResource Brush.Menu}"
                                      TipForeground="{DynamicResource Brush.Text}" />
                      </StackPanel>

                      <TextBlock Visibility="{Binding NoDataVisibility}" Margin="52,12,0,0" Style="{StaticResource Text.Muted}" FontSize="12.5" TextWrapping="Wrap"
                                 Text="Claude saves a usage reading about every 15 minutes while this account is open. Open it once and its usage shows up here." />
                      <TextBlock Visibility="{Binding SharedVisibility}" Text="{Binding SharedText}" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Brush.Warning}" />
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter TargetName="UsageAction" Property="Style" Value="{StaticResource Button.Secondary}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="Open">
                      <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RunState}" Value="Background">
                      <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Profile.Plan}" Value="Max">
                      <Setter TargetName="PlanChip" Property="Style" Value="{StaticResource Chip.Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Profile.Plan}" Value="Team">
                      <Setter TargetName="PlanChip" Property="Style" Value="{StaticResource Chip.Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Profile.Plan}" Value="Enterprise">
                      <Setter TargetName="PlanChip" Property="Style" Value="{StaticResource Chip.Accent}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Text.Caption}" Margin="4,4,4,0" LineHeight="17"
                       Text="These numbers come from the Claude app on this computer, which saves each account's usage about every 15 minutes while it is open. Use on the web or on other devices shows up with that account's next reading here. Reset times are worked out from past readings; “by” is the latest it can be." />
          </StackPanel>

          <!-- ============ Switching ============ -->
          <StackPanel x:Name="PageSwitching" Visibility="Collapsed">
            <TextBlock Text="Switching" Style="{StaticResource Text.Display}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,6,0,26"
                       Text="Switch from the tray icon, the keyboard shortcut, or a button on the Claude window." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="SamePlaceToggle" Style="{StaticResource Toggle}" Checked="OnSamePlaceToggle" Unchecked="OnSamePlaceToggle">
                  <StackPanel>
                    <TextBlock Text="Open the account where the current window is" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                               Text="An account that opens takes the size and place of the window you are in. An account that is already open stays where you put it, unless the window you leave is minimized or closed." />
                  </StackPanel>
                </CheckBox>
                <Border Style="{StaticResource Divider}" />
                <TextBlock Text="The window you switch away from" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                <RadioButton x:Name="LeaveOpenRadio" GroupName="leave" Margin="0,0,0,10" Checked="OnLeaveChanged">
                  <TextBlock><Run Text="Leave it open" /><Run Text="   Switching back is instant." Foreground="{DynamicResource Brush.TextSubtle}" FontSize="12.5" /></TextBlock>
                </RadioButton>
                <RadioButton x:Name="MinimizeRadio" GroupName="leave" Margin="0,0,0,10" Content="Minimize it" Checked="OnLeaveChanged" />
                <RadioButton x:Name="CloseRadio" GroupName="leave" Checked="OnLeaveChanged">
                  <TextBlock><Run Text="Close it" /><Run Text="   Like clicking its X button." Foreground="{DynamicResource Brush.TextSubtle}" FontSize="12.5" /></TextBlock>
                </RadioButton>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="OverlayToggle" Style="{StaticResource Toggle}" Checked="OnOverlayToggle" Unchecked="OnOverlayToggle">
                  <StackPanel>
                    <TextBlock Text="Show a switch button on Claude windows" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                               Text="A small button with the account's name, on the Claude window in front. Drag it anywhere on the window; it remembers the spot." />
                  </StackPanel>
                </CheckBox>
                <Border Style="{StaticResource Divider}" />
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Show on" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                               Text="With several accounts open, a button on every window tells them apart." />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource SegmentBar}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ScopeFront" Style="{StaticResource Segment}" GroupName="scope" Content="Window in front" Checked="OnScopeChanged" />
                      <RadioButton x:Name="ScopeEvery" Style="{StaticResource Segment}" GroupName="scope" Content="Every Claude window" Checked="OnScopeChanged" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Position" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="CornerTopRight" Style="{StaticResource Segment}" GroupName="corner" Content="Top right" Checked="OnCornerChanged" />
                      <RadioButton x:Name="CornerTopLeft" Style="{StaticResource Segment}" GroupName="corner" Content="Top left" Checked="OnCornerChanged" />
                      <RadioButton x:Name="CornerBottomRight" Style="{StaticResource Segment}" GroupName="corner" Content="Bottom right" Checked="OnCornerChanged" />
                      <RadioButton x:Name="CornerBottomLeft" Style="{StaticResource Segment}" GroupName="corner" Content="Bottom left" Checked="OnCornerChanged" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox x:Name="HotkeyToggle" Style="{StaticResource Toggle}" Checked="OnHotkeyToggle" Unchecked="OnHotkeyToggle">
                  <StackPanel>
                    <TextBlock Text="Keyboard shortcut" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0" Text="Opens the switcher from anywhere. Press 1 to 9 to pick an account." />
                  </StackPanel>
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <c:HotkeyBox x:Name="HotkeyInput" Width="200" Height="38" Padding="11,0" VerticalContentAlignment="Center"
                               VerticalAlignment="Center" ToolTip="Click, then press the new shortcut" />
                  <Border x:Name="HotkeyChip" Style="{StaticResource Chip}" Margin="12,0,0,0">
                    <TextBlock x:Name="HotkeyStatus" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ Sign-in ============ -->
          <StackPanel x:Name="PageSignIn" Visibility="Collapsed">
            <TextBlock Text="Sign-in" Style="{StaticResource Text.Display}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,6,0,26"
                       Text="Sign in once per account. Tandem makes sure the browser's sign-in reaches the right one." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HelperIconBox" Width="46" Height="46" CornerRadius="23" VerticalAlignment="Top">
                  <TextBlock x:Name="HelperIcon" Style="{StaticResource Text.Icon}" FontSize="19" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,2,16,0">
                  <TextBlock x:Name="HelperTitle" Style="{StaticResource Text.Heading}" />
                  <TextBlock x:Name="HelperText" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <Button x:Name="HelperButton" Click="OnHelperButton" MinWidth="120" />
                  <Button x:Name="HelperSettingsButton" Style="{StaticResource Button.Link}" Content="Open Windows Settings" Margin="0,10,0,0"
                          HorizontalAlignment="Center" Click="OnHelperSettings" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="How it works" Style="{StaticResource Text.Section}" Margin="0,0,0,14" />
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource StepCircle}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock Grid.Column="1" Margin="14,5,0,0" Style="{StaticResource Text.Muted}" FontSize="13"
                             Text="Claude signs you in through your browser, which then hands the sign-in back with a claude:// link." />
                </Grid>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource StepCircle}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock Grid.Column="1" Margin="14,5,0,0" Style="{StaticResource Text.Muted}" FontSize="13"
                             Text="Windows normally sends those links to your original Claude. With the helper on, you choose Tandem for them once, in Windows Settings." />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource StepCircle}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock Grid.Column="1" Margin="14,5,0,0" Style="{StaticResource Text.Muted}" FontSize="13"
                             Text="Tandem passes each link, unchanged and never saved, to the account that is signing in. Claude's own settings stay untouched." />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Other claude:// links" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,14" Text="When no account is waiting for sign-in, open them in" />
                <RadioButton x:Name="FallbackLastActive" GroupName="fallback" Content="the account I used last" Margin="0,0,0,10" Checked="OnFallbackChanged" />
                <RadioButton x:Name="FallbackDefault" GroupName="fallback" Content="my original account" Checked="OnFallbackChanged" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ General ============ -->
          <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
            <TextBlock Text="General" Style="{StaticResource Text.Display}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,6,0,26" Text="App setup, appearance, startup and files." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="SyncSetupToggle" Style="{StaticResource Toggle}" Checked="OnSyncSetupToggle" Unchecked="OnSyncSetupToggle">
                  <StackPanel>
                    <TextBlock Text="Same app setup in every account" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                               Text="Before an account opens, it gets your original Claude's MCP servers, extensions, settings, SSH connections and Code presets. Sign-in and chats stay with each account." />
                  </StackPanel>
                </CheckBox>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                           Text="The previous version of every replaced file is kept in %LOCALAPPDATA%\Tandem\Backups." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Theme" Style="{StaticResource Text.Section}" />
                  <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0" Text="Follow Windows, or always light or dark." />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentBar}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="theme" Content="System" Checked="OnThemeChanged" />
                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="theme" Content="Light" Checked="OnThemeChanged" />
                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="theme" Content="Dark" Checked="OnThemeChanged" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" Checked="OnStartupToggle" Unchecked="OnStartupToggle">
                  <StackPanel>
                    <TextBlock Text="Start Tandem with Windows" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0" Text="Starts quietly in the tray." />
                  </StackPanel>
                </CheckBox>
                <Border Style="{StaticResource Divider}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Start menu" Style="{StaticResource Text.Section}" />
                    <TextBlock x:Name="StartMenuText" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                  </StackPanel>
                  <Button x:Name="StartMenuButton" Grid.Column="1" Content="Add to Start menu" VerticalAlignment="Center" Click="OnAddAppShortcut" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Files" Style="{StaticResource Text.Section}" />
                  <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                             Text="Settings in %APPDATA%\Tandem; account folders and logs in %LOCALAPPDATA%\Tandem." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Logs" Click="OnOpenLogs" Margin="0,0,8,0" />
                  <Button Content="Open folder" Click="OnOpenDataFolder" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <!-- ============ About ============ -->
          <StackPanel x:Name="PageAbout" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="28,26" Margin="0,8,0,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="pack://application:,,,/Tandem;component/Assets/Tandem.ico" Width="56" Height="56"
                         RenderOptions.BitmapScalingMode="HighQuality" />
                  <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tandem" Style="{StaticResource Text.Display}" FontSize="28" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Text.Muted}" />
                  </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource Chip.Accent}" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="10,4">
                  <TextBlock Text="Unofficial. Not affiliated with or endorsed by Anthropic." FontWeight="SemiBold" />
                </Border>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextMuted}"
                           Text="Tandem starts the official Claude app, unmodified, with a separate data folder for each account. Nothing is patched or injected, so the app's updates keep working." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                  <TextBlock Text="A" FontFamily="{StaticResource Font.Display}" FontSize="21" Foreground="{DynamicResource Brush.OnAccent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                  <TextBlock Text="AUTHOR" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" />
                  <TextBlock Text="Arman Manteghi" Style="{StaticResource Text.Heading}" FontSize="19" Margin="0,1,0,0" />
                  <TextBlock Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,2,0,0">
                    <Run Text="Designed and built Tandem  ·  GitHub" /> <Run Text="@Arman-Manteghi" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Center" Click="OnAuthorPage" ToolTip="github.com/Arman-Manteghi">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,9,0" />
                    <TextBlock Text="GitHub profile" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Privacy" Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,0,0,8" Text="•  No network connections, no telemetry, no automatic updates." />
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,0,0,8" Text="•  Never reads, copies or sends sign-in data, cookies or tokens." />
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="•  For Usage, reads only the usage numbers Claude saves for each account, read-only and never logged." />
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,0,0,8" Text="•  Logs hold account ids only: no names, no links, no user name." />
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="13" Text="•  Deleting an account moves its folder to the Recycle Bin, never permanently." />
                <Border Style="{StaticResource Divider}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                             Text="MIT license. Claude is a trademark of Anthropic." />
                  <Button Grid.Column="1" Style="{StaticResource Button.Link}" Content="Project page on GitHub" Click="OnProjectPage" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
