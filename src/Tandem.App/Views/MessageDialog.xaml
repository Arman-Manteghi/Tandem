<Window x:Class="Tandem.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Tandem.App.Controls"
        Style="{StaticResource Window.Dialog}"
        Width="480" SizeToContent="Height" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Tandem;component/Assets/Tandem.ico">
  <Grid>
    <StackPanel Margin="30,26,30,26">
      <Border x:Name="IconBox" Width="42" Height="42" CornerRadius="21" HorizontalAlignment="Left" Margin="0,0,0,16"
              Background="{DynamicResource Brush.AccentSoft}">
        <TextBlock x:Name="IconGlyph" Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="18" HorizontalAlignment="Center"
                   Foreground="{DynamicResource Brush.AccentText}" />
      </Border>
      <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" FontSize="21" />
      <TextBlock x:Name="Message" Style="{StaticResource Text.Body}" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
      <Border x:Name="DetailsBox" Visibility="Collapsed" Margin="0,16,0,0" Padding="14,12" CornerRadius="12"
              Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <ItemsControl x:Name="Details">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" Margin="0,2" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
        <Button x:Name="TertiaryButton" Visibility="Collapsed" Margin="0,0,8,0" Click="OnTertiary" />
        <Button x:Name="SecondaryButton" Visibility="Collapsed" Margin="0,0,8,0" IsCancel="True" Click="OnSecondary" />
        <Button x:Name="PrimaryButton" Style="{StaticResource Button.Primary}" IsDefault="True" Click="OnPrimary" MinWidth="96" />
      </StackPanel>
    </StackPanel>
    <c:TitleBar ShowMinimize="False" ShowMaximize="False" />
  </Grid>
</Window>
