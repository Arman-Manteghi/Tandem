<Window x:Class="Tandem.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False"
        FontFamily="{StaticResource Font.UI}" Left="-32000" Top="-32000"
        Title="Tandem switch button">
  <Border x:Name="Pill" Margin="8" Height="30" CornerRadius="15" Padding="4,0,10,0" BorderThickness="1"
          BorderBrush="{DynamicResource Brush.OverlayBorder}" Cursor="Hand"
          ToolTip="Switch account · drag to move">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.OverlayHover}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Border.Effect>
      <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Opacity="0.22" Color="Black" />
    </Border.Effect>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="Avatar" Width="22" Height="22" CornerRadius="11">
        <TextBlock x:Name="InitialText" FontFamily="{StaticResource Font.Display}" FontSize="12" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
      </Border>
      <TextBlock x:Name="NameText" Margin="8,0,7,0" FontSize="12.5" FontWeight="SemiBold" MaxWidth="180"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
      <TextBlock Text="&#xE70D;" Style="{StaticResource Text.Icon}" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
    </StackPanel>
  </Border>
</Window>
