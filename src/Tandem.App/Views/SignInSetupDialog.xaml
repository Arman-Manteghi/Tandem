<Window x:Class="Tandem.App.Views.SignInSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Tandem.App.Controls"
        Style="{StaticResource Window.Dialog}"
        Width="560" SizeToContent="Height" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Set up sign-in" Icon="pack://application:,,,/Tandem;component/Assets/Tandem.ico">
  <Window.Resources>
    <Style x:Key="StepCircle" TargetType="Border">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource Brush.Badge}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
  </Window.Resources>
  <Grid>
    <StackPanel Margin="32,28,32,26">
      <Border x:Name="IconBox" Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Left" Margin="0,0,0,16"
              Background="{DynamicResource Brush.AccentSoft}">
        <TextBlock x:Name="IconGlyph" Text="&#xE8D7;" Style="{StaticResource Text.Icon}" FontSize="19" HorizontalAlignment="Center"
                   Foreground="{DynamicResource Brush.AccentText}" />
      </Border>
      <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" Text="One-time setup for signing in" />
      <TextBlock x:Name="Intro" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,8,0,22"
                 Text="Google and email sign-ins finish in your browser, which then opens the app with a claude:// link. With this set up once, that link always reaches the account you are signing in to, never the one that is already signed in." />

      <!-- Step 1 -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Step1Circle" Style="{StaticResource StepCircle}">
          <TextBlock x:Name="Step1Mark" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.TextMuted}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,4,0,0">
          <TextBlock Text="Let Tandem receive sign-in links" Style="{StaticResource Text.Section}" />
          <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                     Text="Adds Tandem's own entries for your Windows user. Claude's entries stay as they are; no administrator rights." />
          <Button x:Name="DetailsToggle" Style="{StaticResource Button.Link}" Content="Show exactly what is added" HorizontalAlignment="Left"
                  Margin="0,6,0,0" FontSize="12" Click="OnToggleDetails" />
          <Border x:Name="DetailsBox" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,10" CornerRadius="10"
                  Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <ItemsControl x:Name="Details">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Step 2 -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Step2Circle" Style="{StaticResource StepCircle}">
          <TextBlock x:Name="Step2Mark" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.TextMuted}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,4,0,0">
          <TextBlock Text="Choose Tandem for CLAUDE links" Style="{StaticResource Text.Section}" />
          <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                     Text="Windows Settings opens on Tandem's page. Click the box next to CLAUDE and pick Tandem. Windows only lets you make this choice yourself; Tandem notices it right away." />
          <StackPanel x:Name="WaitingRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="Spinner" Text="&#xE895;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.AccentText}"
                       RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform />
              </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="WaitingText" Text="Waiting for your choice in Windows Settings…" Margin="8,0,0,0" FontSize="12.5"
                       Foreground="{DynamicResource Brush.AccentText}" />
            <Button x:Name="OpenSettingsLink" Style="{StaticResource Button.Link}" Content="Open it again" Margin="12,0,0,0" FontSize="12.5"
                    Click="OnOpenSettings" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Step 3 -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Step3Circle" Style="{StaticResource StepCircle}">
          <TextBlock x:Name="Step3Mark" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.TextMuted}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,4,0,0">
          <TextBlock Text="Sign in once" Style="{StaticResource Text.Section}" />
          <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                     Text="In the new account's window choose Google or email. When the browser asks to open the app (it may say Tandem), choose Open. That window signs in and stays signed in." />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="ErrorText" Margin="0,14,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" Visibility="Collapsed" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
        <Button x:Name="LaterButton" Content="Not now" Margin="0,0,8,0" IsCancel="True" Click="OnLater" />
        <Button x:Name="PrimaryButton" Style="{StaticResource Button.Primary}" Content="Set up" MinWidth="130" IsDefault="True" Click="OnPrimary" />
      </StackPanel>
    </StackPanel>
    <c:TitleBar ShowMinimize="False" ShowMaximize="False" />
  </Grid>
</Window>
