<Window x:Class="Tandem.App.Views.SwitcherMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource Font.UI}" Left="-32000" Top="-32000" Opacity="0"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Title="Tandem – switch account">
  <Border x:Name="Card" Margin="16" Width="336" Padding="6" CornerRadius="14" BorderThickness="1"
          Background="{DynamicResource Brush.Menu}" BorderBrush="{DynamicResource Brush.Border}"
          RenderTransformOrigin="0.5,1">
    <Border.RenderTransform>
      <TransformGroup>
        <ScaleTransform />
        <TranslateTransform />
      </TransformGroup>
    </Border.RenderTransform>
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.26" Color="Black" />
    </Border.Effect>
    <StackPanel>
      <Grid Margin="10,8,8,8">
        <TextBlock Text="Switch account" Style="{StaticResource Text.Heading}" FontSize="16" VerticalAlignment="Center" />
        <Border x:Name="HotkeyHint" Style="{StaticResource Chip}" HorizontalAlignment="Right" Visibility="Collapsed">
          <TextBlock x:Name="HotkeyHintText" />
        </Border>
      </Grid>
      <ScrollViewer MaxHeight="380" Style="{StaticResource ScrollViewer.Modern}">
        <StackPanel x:Name="Items" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
      </ScrollViewer>
      <Border Height="1" Margin="8,6" Background="{DynamicResource Brush.Border}" />
      <StackPanel x:Name="Commands" KeyboardNavigation.DirectionalNavigation="Cycle" />
    </StackPanel>
  </Border>
</Window>
